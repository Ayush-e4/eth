# Copy to .env and fill in. Never commit .env.
# Hedera testnet account (portal.hedera.com, ECDSA key)
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_EVM_ADDRESS=

# HCS topic for the public spend log: payments, limits, hires (create: pnpm --filter @eth/hedera create-topic)
SPEND_LOG_TOPIC_ID=

# Only after a testnet reset (pnpm setup:testnet --fix prints them): the redeployed contract, and
# Circle's test USDC if its id changed. Leave empty to use the current ones.
MANDATE_REGISTRY_ADDRESS=
MANDATE_REGISTRY_ID=
USDC_TOKEN_ID=
# The passkey (Face ID) wallet factory, if redeployed: pnpm --filter @eth/mandates deploy-wallet-factory
PASSKEY_WALLET_FACTORY=

# Agents
ANTHROPIC_API_KEY=        # console.anthropic.com — orchestrator (Claude)
DUFFEL_ACCESS_TOKEN=      # app.duffel.com → Developers → Access tokens (test mode) — starts with duffel_test_
LITEAPI_KEY=              # dashboard.liteapi.travel — sandbox key (sand_…), flights + hotels

# API (apps/api). Defaults work for local dev with `pnpm db:up`.
DATABASE_URL=postgres://eth:eth@127.0.0.1:54329/eth
APP_ORIGIN=http://localhost:3000
ADMIN_WALLETS=
DEMO_MODE=on
UNDO_SECONDS=60           # undo window for payments in "Auto" chats (Hedera scheduled tx); 0 = off
# Demo accounts share one test wallet; daily allowances (rolling 24 h). Raise them for local testing.
DEMO_MESSAGES_PER_DAY=40
DEMO_HIRES_PER_DAY=5
DEMO_LIMITS_PER_DAY=3
DEMO_LIMITS_TOTAL_PER_DAY=40          # all demo accounts together
DEMO_FEES_TOTAL_PER_DAY_USDC=3        # agent fees the demo wallet pays a day, all accounts together
# Passkey sign-ups get their own Face ID wallet with free test USDC from the demo wallet.
WALLET_GIFT_UNITS=500000              # 0.50 USDC each (0 = no gift)
WALLET_GIFTS_PER_DAY=20               # new wallets gifted a day, all accounts together

# World ID (Agent Pass) for "Ask first" approvals: register an app at https://auth.world.org/portal
# (Google sign-in), client auth client_secret_basic. Leave empty to approve without a human check.
WORLD_ID_ISSUER=https://auth.world.org
WORLD_ID_CLIENT_ID=
WORLD_ID_CLIENT_SECRET=

# Arkiv access key for the Rabdi testnet (needed in practice: the keyless budget is tiny). Get one at
# https://hub.arkiv.network/access-keys (wallet sign-in). Server-side only.
ARKIV_API_KEY=
